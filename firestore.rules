rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection test document
    match /test/{testId} {
      allow read: if true;
    }

    // User profile documents
    match /users/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);
    }

    // Notebooks collection
    match /notebooks/{notebookId} {
      allow get, list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() 
        && isValidId(notebookId)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string 
        && request.resource.data.name.size() > 0 
        && request.resource.data.name.size() <= 120;
      allow update: if isSignedIn() 
        && isValidId(notebookId)
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isSignedIn() 
        && isValidId(notebookId)
        && resource.data.ownerId == request.auth.uid;

      // Subcollections within Notebook
      match /sources/{sourceId} {
        allow get, list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
        allow create, update, delete: if isSignedIn() 
          && isValidId(sourceId)
          && (request.resource.data.ownerId == request.auth.uid || resource.data.ownerId == request.auth.uid);
      }

      match /notes/{noteId} {
        allow get, list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
        allow create, update, delete: if isSignedIn() 
          && isValidId(noteId)
          && (request.resource.data.ownerId == request.auth.uid || resource.data.ownerId == request.auth.uid);
      }

      match /flashcards/{cardId} {
        allow get, list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
        allow create, update, delete: if isSignedIn() 
          && isValidId(cardId)
          && (request.resource.data.ownerId == request.auth.uid || resource.data.ownerId == request.auth.uid);
      }

      match /todos/{todoId} {
        allow get, list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
        allow create, update, delete: if isSignedIn() 
          && isValidId(todoId)
          && (request.resource.data.ownerId == request.auth.uid || resource.data.ownerId == request.auth.uid);
      }

      match /chatSessions/{sessionId} {
        allow get, list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
        allow create, update, delete: if isSignedIn() 
          && isValidId(sessionId)
          && (request.resource.data.ownerId == request.auth.uid || resource.data.ownerId == request.auth.uid);
      }
    }
  }
}
