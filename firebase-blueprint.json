{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email"]
    },
    "Notebook": {
      "title": "Notebook",
      "description": "Study notebook containing subject sources and notes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "name": { "type": "string", "maxLength": 120 },
        "subject": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "name"]
    },
    "Source": {
      "title": "Source",
      "description": "Study document or reference source",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "notebookId": { "type": "string" },
        "ownerId": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "type": { "type": "string" },
        "content": { "type": "string" },
        "size": { "type": "number" },
        "pageCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "notebookId", "ownerId", "title"]
    },
    "Note": {
      "title": "Note",
      "description": "Student notes, study summaries and reflections",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "notebookId": { "type": "string" },
        "ownerId": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "text": { "type": "string" },
        "tags": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "notebookId", "ownerId", "title"]
    },
    "Flashcard": {
      "title": "Flashcard",
      "description": "Spaced repetition flashcard for revision",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "notebookId": { "type": "string" },
        "ownerId": { "type": "string" },
        "front": { "type": "string" },
        "back": { "type": "string" },
        "level": { "type": "number" },
        "nextReview": { "type": "number" }
      },
      "required": ["id", "notebookId", "ownerId", "front", "back"]
    },
    "Todo": {
      "title": "Todo",
      "description": "Study task or goal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "notebookId": { "type": "string" },
        "ownerId": { "type": "string" },
        "text": { "type": "string" },
        "dueDate": { "type": "string" },
        "done": { "type": "boolean" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "notebookId", "ownerId", "text"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "Chat session with AI",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "notebookId": { "type": "string" },
        "ownerId": { "type": "string" },
        "title": { "type": "string" },
        "messages": { "type": "array" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "notebookId", "ownerId", "title"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile store"
    },
    "/notebooks/{notebookId}": {
      "schema": { "$ref": "#/entities/Notebook" },
      "description": "Collection of notebooks"
    },
    "/notebooks/{notebookId}/sources/{sourceId}": {
      "schema": { "$ref": "#/entities/Source" },
      "description": "Sources attached to a notebook"
    },
    "/notebooks/{notebookId}/notes/{noteId}": {
      "schema": { "$ref": "#/entities/Note" },
      "description": "Notes attached to a notebook"
    },
    "/notebooks/{notebookId}/flashcards/{cardId}": {
      "schema": { "$ref": "#/entities/Flashcard" },
      "description": "Flashcards attached to a notebook"
    },
    "/notebooks/{notebookId}/todos/{todoId}": {
      "schema": { "$ref": "#/entities/Todo" },
      "description": "Tasks attached to a notebook"
    },
    "/notebooks/{notebookId}/chatSessions/{sessionId}": {
      "schema": { "$ref": "#/entities/ChatSession" },
      "description": "Chat sessions attached to a notebook"
    }
  }
}
